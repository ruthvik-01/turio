# Turio environment template.
#
# Settings reference only; replace placeholders for your provisioned services.
# The native launcher reads private .runtime/native/env.json, not this template.
# Direct backend commands can use a .env in their working directory.
# Never commit real environment files or credentials. See docs/DEPLOYMENT.md.

APP_ENV=development
APP_VERSION=0.1.0

# Backend -> provisioned native PostgreSQL; use your database/user/password.
DATABASE_URL=postgresql+psycopg://turio:replace_me@127.0.0.1:18543/turio

# JWT signing key (Phase 1). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_me_with_a_long_random_value

# S3-compatible resume storage. The native development runtime uses S3rver on
# port 19000; deployment uses Supabase Storage's S3 endpoint.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
OBJECT_STORAGE_BUCKET=turio-resumes
OBJECT_STORAGE_ACCESS_KEY=replace_me
OBJECT_STORAGE_SECRET_KEY=replace_me
# S3rver and MinIO create the bucket on demand; Supabase Storage does not.
OBJECT_STORAGE_ENSURE_BUCKET=true

# Job dataset (Phase 3). The Stapply Ashby slice, downloaded to data/ by hand:
#   curl -o data/ashby-jobs.csv https://storage.stapply.ai/jobhive/v1/ashby/jobs.csv
# Expected sha256: 2e57b5baf89df8b0dafd7f87a62c4c46fc329ea33d8315f8a391b585d89dd9d1
JOB_DATASET_PATH=data/ashby-jobs.csv

# Browser -> Next.js same-origin proxy -> native API
CORS_ORIGINS=http://127.0.0.1:13000
INTERNAL_API_BASE_URL=http://127.0.0.1:18080/api/v1

# Optional capabilities use requirements-ml.txt / requirements-browser.txt.
# Neither changes the approved frontend direction.
# Download the pinned public model with scripts/download_model.py first.
MODEL_LOCAL_FILES_ONLY=true
# Browser assistance remains experimental; no company is verified yet.
BROWSER_AUTOMATION_ENABLED=false
# Visible mode requires a desktop display on the backend host, not the web client.
BROWSER_HEADLESS=true
# Browser Use Agent model routing. Model IDs and region must match your accounts.
# These settings do not enable browser automation or bypass submission approval.
BROWSER_AGENT_PRIMARY_PROVIDER=openrouter
BROWSER_AGENT_FALLBACK_PROVIDER=bedrock_mantle
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
BEDROCK_MANTLE_API_KEY=
BEDROCK_MANTLE_MODEL=
BEDROCK_MANTLE_REGION=
BROWSER_AGENT_LLM_TIMEOUT_SECONDS=60
BROWSER_AGENT_MAX_OUTPUT_TOKENS=4096
ANONYMIZED_TELEMETRY=false
# Database worker leases are renewed while a run is active. No automatic replay.
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
# No LLM key is required. Parsing and factual answer starters are deterministic.

# Optional bounded assistance; always requires per-action consent.
ASSISTANCE_ENABLED=false
# Free assistance model is pinned to dots-studio/dots-3-note-preview:free.
# Uses OPENROUTER_API_KEY from the project-root .env; Open_Router alias is accepted.
