# Turio environment template.
#
# Copy to .env for local use. Never commit a real .env.
# Every value here is a placeholder. docker-compose.yml also supplies the same
# defaults inline, so `docker compose up` works from a clean clone with no .env
# present - see PHASE_PLAN.md Phase 0 exit checklist item (d).

APP_ENV=development
APP_VERSION=0.1.0

# Backend -> PostgreSQL. The host `postgres` is the compose service name.
DATABASE_URL=postgresql+psycopg://turio:replace_me@postgres:5432/turio

# PostgreSQL container initialisation
POSTGRES_USER=turio
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=turio

# JWT signing key (Phase 1). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_me_with_a_long_random_value

# Object storage for resume binaries (Phase 2). S3-compatible; MinIO locally.
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_BUCKET=turio-resumes
OBJECT_STORAGE_ACCESS_KEY=turio_minio
OBJECT_STORAGE_SECRET_KEY=replace_me_minio

# Job dataset (Phase 3). The Stapply Ashby slice, downloaded to data/ by hand:
#   curl -o data/ashby-jobs.csv https://storage.stapply.ai/jobhive/v1/ashby/jobs.csv
# Expected sha256: 2e57b5baf89df8b0dafd7f87a62c4c46fc329ea33d8315f8a391b585d89dd9d1
JOB_DATASET_PATH=data/ashby-jobs.csv

# Browser -> API
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1

# Optional runtime capabilities. Neither changes the approved frontend direction.
# Set build flags before rebuilding the Compose backend image.
INSTALL_ML=false
INSTALL_BROWSER=false
# Download the pinned public model with scripts/download_model.py first.
MODEL_LOCAL_FILES_ONLY=true
# Browser assistance remains experimental; no company is verified yet.
BROWSER_AUTOMATION_ENABLED=false
# Visible mode requires a desktop display on the backend host, not the web client.
BROWSER_HEADLESS=true
ANONYMIZED_TELEMETRY=false
# Database worker leases are renewed while a run is active. No automatic replay.
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
# No LLM key is required. Parsing and factual answer starters are deterministic.
