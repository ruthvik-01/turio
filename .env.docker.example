# Turio container deployment environment.
#
#   cp .env.docker.example .env.docker
#   # fill in DATABASE_URL, SECRET_KEY and the object-storage credentials
#   docker compose --env-file .env.docker up -d --build
#
# Never commit the filled-in file. .gitignore covers .env.* except this template.

# --- application ---
APP_ENV=production
APP_VERSION=0.1.0

# --- database: Supabase ---
# Project: djjmyyvbpgkvxwsjiejp (region ap-southeast-2)
# Dashboard -> Project Settings -> Database -> Connection string.
# Use the SESSION pooler (port 5432) or the direct connection.
# Do NOT use the transaction pooler on port 6543: Alembic migrations and
# psycopg's prepared statements do not survive transaction-mode pooling.
#
# The driver prefix must stay postgresql+psycopg (psycopg 3, async-capable).
# The app builds both its async engine and Alembic's sync engine from this URL.
#
# Copy the URI from the dashboard and change only the scheme prefix:
#   postgresql://...   ->   postgresql+psycopg://...
#
# Session pooler shape:
DATABASE_URL=postgresql+psycopg://postgres.djjmyyvbpgkvxwsjiejp:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
#
# Direct connection shape (no pooler; fine for low traffic):
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.djjmyyvbpgkvxwsjiejp.supabase.co:5432/postgres?sslmode=require

# --- secrets ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production validation rejects values under 32 chars or containing
# "replace"/"insecure"/"test-only".
SECRET_KEY=

# --- object storage: Supabase Storage (S3 protocol) ---
# Dashboard -> Project Settings -> Storage -> S3 Configuration.
# Generate an access key pair there. These credentials bypass RLS and grant
# full access to every bucket, so they are server-side only: never expose them
# to the frontend or commit them.
#
# Endpoint: use the direct storage hostname, not the project hostname. It is
# faster for uploads and is what the Supabase docs recommend.
OBJECT_STORAGE_ENDPOINT=https://djjmyyvbpgkvxwsjiejp.storage.supabase.co/storage/v1/s3
# Region must match the project region exactly, or signing fails with
# SignatureDoesNotMatch.
OBJECT_STORAGE_REGION=ap-southeast-2
OBJECT_STORAGE_BUCKET=turio-resumes
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Supabase Storage has no CreateBucket API. The bucket is created in the
# dashboard or by SQL, so the startup check must stay read-only.
OBJECT_STORAGE_ENSURE_BUCKET=false

# --- frontend ---
# Same-origin proxy target on the compose network. Not baked into the bundle.
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
# Origins allowed by the API's CORS middleware. The browser only reaches the
# API through the Next.js proxy, so this is the public frontend origin.
CORS_ORIGINS=http://localhost:3000

# --- host ports ---
API_PORT=8000
FRONTEND_PORT=3000

# --- job dataset ---
# Mounted read-only from ./data. Only POST /jobs/refresh reads it.
JOB_DATASET_PATH=/app/data/stapply-expanded-jobs.csv

# --- optional capabilities (both off by default) ---
# Set INSTALL_ML=true and INSTALL_BROWSER=true to build those layers.
INSTALL_ML=false
INSTALL_BROWSER=false
MODEL_LOCAL_FILES_ONLY=true
BROWSER_AUTOMATION_ENABLED=false
BROWSER_HEADLESS=true

# --- optional LLM assistance ---
ASSISTANCE_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
BEDROCK_MANTLE_API_KEY=
BEDROCK_MANTLE_MODEL=
BEDROCK_MANTLE_REGION=

# --- worker ---
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=60
